# Local development (docker compose reads this file). See docs/deployment/nuc-almaz.md for production.
API_ADDR=:8080
DATABASE_URL=postgres://museum:museum@localhost:5432/invisible_museum?sslmode=disable
PUBLIC_BASE_URL=http://localhost:8080

# Sign-in. DEV_AUTH_ENABLED lets anyone sign in by email: local only.
DEV_AUTH_ENABLED=true
# Visitor research suggestions stay closed unless explicitly enabled.
PUBLIC_ROUTE_BRIEF_INTAKE_ENABLED=false
# Curator import from retained inspected announcements; never starts a social feed.
HAPPENINGS_IMPORT_ENABLED=false
ADMIN_BOOTSTRAP_EMAILS=admin@example.com
APPLE_CLIENT_IDS=
GOOGLE_CLIENT_IDS=
SESSION_TTL_HOURS=2160

# Routing: straightline (dev) or valhalla (compose --profile routing).
ROUTING_PROVIDER=straightline
VALHALLA_URL=http://localhost:8002

# Narration: none (clients use on-device speech) or openai (any OpenAI-compatible /v1/audio/speech).
NARRATION_PROVIDER=none
NARRATION_BASE_URL=https://api.openai.com
NARRATION_API_KEY=
NARRATION_MODEL=gpt-4o-mini-tts
NARRATION_VOICE=alloy

# Media: fs (local directory served at /media/files) or s3 (MinIO, R2, S3).
MEDIA_STORE=fs
MEDIA_FS_DIR=./data/media
MEDIA_PUBLIC_BASE_URL=
S3_ENDPOINT=localhost:9000
S3_BUCKET=museum-media
S3_ACCESS_KEY=museum
S3_SECRET_KEY=museum-secret
S3_USE_SSL=false

# LLM drafting and topic ranking. Empty disables the draft and suggest endpoints.
#   anthropic: Claude API via the official SDK (LLM_MODEL default claude-opus-5-5)
#   openai:    any OpenAI-compatible chat completions endpoint (OpenAI, Ollama, vLLM, OpenRouter)
LLM_PROVIDER=
LLM_API_KEY=
LLM_BASE_URL=
LLM_MODEL=

# Sourcing. Local archive pages are read by the "url" adapter; keep the User-Agent descriptive.
LOCAL_ARCHIVE_URLS=
SOURCES_USER_AGENT=InvisibleMuseum/0.2 (+https://github.com/subculture-collective/byl)
# Media downloads refuse loopback, private, link-local and CGNAT addresses (SSRF guard).
# Set to true only in development or when a trusted LAN archive hosts the files.
SOURCES_ALLOW_PRIVATE_HOSTS=false

# Private brief discovery, started explicitly through the curator research API.
# No provider credentials are required. Comma-separated allowlist; at most three.
BRIEF_DISCOVERY_PROVIDERS=wikipedia_search,loc,internet_archive
# Optional: up to four starting pages; their hosts permit supplied/reference URLs.
# Defaults: dghistory.org and the Downers Grove / DuPage Wikipedia overviews.
BRIEF_DISCOVERY_SEED_URLS=

JOB_WORKERS=2

# Tests
TEST_DATABASE_URL=postgres://museum:museum@localhost:5432/invisible_museum?sslmode=disable
